{
  "$comment": "Sumber tunggal nilai visual MySuka. Edit di sini lalu jalankan `npm run assets`. v2 = v1 + token aksesibel, spacing, elevation, motion, z-index, layout kontrak.",
  "version": "2.0.0",
  "color": {
    "primary": "#155E38",
    "primaryDark": "#0F4A2C",
    "primarySoft": "#E4F1E8",
    "secondary": "#C59B27",
    "secondaryTextOnLight": "#7A5A00",
    "secondaryTextOnDark": "#EBCB6B",
    "background": "#F8FAFC",
    "surface": "#FFFFFF",
    "text": "#14261B",
    "textMuted": "#44574B",
    "textOnPrimary": "#FFFFFF",
    "textOnPrimaryMuted": "#DCEBE2",
    "border": "#DCE7E0",
    "borderStrong": "#C3D5C9",
    "borderControl": "#769080",
    "focus": "#1C5DA8",
    "focusOnDark": "#FFFFFF",
    "statusNew": "#5E6E63",
    "warning": "#A8540A",
    "warningSoft": "#FBF0E4",
    "warningBorder": "#ECD3B6",
    "info": "#1C5DA8",
    "success": "#1B7A43",
    "danger": "#B3261E"
  },
  "font": {
    "family": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "weights": [400, 500, 600, 700, 800]
  },
  "type": {
    "hero": "clamp(2.25rem, 1.5rem + 2.8vw, 3.25rem)",
    "title": "clamp(1.75rem, 1.4rem + 1vw, 2rem)",
    "cardTitle": "1.25rem",
    "lead": "1rem",
    "body": "0.875rem",
    "caption": "0.75rem",
    "button": "0.875rem"
  },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "pill": "999px" },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "elevation": {
    "1": "0 1px 2px rgba(20, 38, 27, 0.08)",
    "2": "0 4px 12px rgba(20, 38, 27, 0.10)",
    "3": "0 12px 32px rgba(20, 38, 27, 0.14)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "easing": "cubic-bezier(0.2, 0, 0, 1)" },
  "z": { "base": 0, "sticky": 30, "overlay": 100, "navbar": 9999 },
  "layout": { "navbarHeight": "64px", "navbarHeightMobile": "56px", "containerMax": "1160px", "mobileBreakpoint": "768px", "minTapTarget": "44px" },
  "legacyAliases": {
    "--green": "color.primary", "--green-dark": "color.primaryDark", "--green-tint": "color.primarySoft", "--gold": "color.secondary",
    "--bg": "color.background", "--surface": "color.surface", "--ink": "color.text", "--ink-2": "color.textMuted",
    "--st-new": "color.statusNew", "--st-warn": "color.warning", "--st-info": "color.info", "--st-ok": "color.success", "--st-err": "color.danger",
    "--line": "color.border", "--line-strong": "color.borderStrong", "--warn-tint": "color.warningSoft", "--warn-line": "color.warningBorder",
    "--r-sm": "radius.sm", "--r-md": "radius.md", "--r-lg": "radius.lg", "--font": "font.family",
    "--ss-primary": "color.primary", "--ss-primary-dark": "color.primaryDark", "--ss-primary-soft": "color.primarySoft", "--ss-secondary": "color.secondary",
    "--ss-bg": "color.background", "--ss-surface": "color.surface", "--ss-text": "color.text", "--ss-muted": "color.textMuted",
    "--ss-new": "color.statusNew", "--ss-warning": "color.warning", "--ss-info": "color.info", "--ss-success": "color.success", "--ss-danger": "color.danger",
    "--ss-radius-sm": "radius.sm", "--ss-radius-md": "radius.md", "--ss-radius-lg": "radius.lg", "--ss-font": "font.family"
  },
  "contrastPairs": [
    { "fg": "text", "bg": "background", "min": 4.5 },
    { "fg": "text", "bg": "surface", "min": 4.5 },
    { "fg": "textMuted", "bg": "background", "min": 4.5 },
    { "fg": "textMuted", "bg": "primarySoft", "min": 4.5 },
    { "fg": "primary", "bg": "surface", "min": 4.5 },
    { "fg": "primary", "bg": "primarySoft", "min": 4.5 },
    { "fg": "textOnPrimary", "bg": "primary", "min": 4.5 },
    { "fg": "textOnPrimary", "bg": "primaryDark", "min": 4.5 },
    { "fg": "textOnPrimaryMuted", "bg": "primary", "min": 4.5 },
    { "fg": "textOnPrimaryMuted", "bg": "primaryDark", "min": 4.5 },
    { "fg": "secondaryTextOnLight", "bg": "surface", "min": 4.5 },
    { "fg": "secondaryTextOnLight", "bg": "background", "min": 4.5 },
    { "fg": "secondaryTextOnDark", "bg": "primaryDark", "min": 4.5 },
    { "fg": "secondaryTextOnDark", "bg": "primary", "min": 4.5 },
    { "fg": "statusNew", "bg": "surface", "min": 4.5 },
    { "fg": "warning", "bg": "warningSoft", "min": 4.5 },
    { "fg": "warning", "bg": "surface", "min": 4.5 },
    { "fg": "info", "bg": "surface", "min": 4.5 },
    { "fg": "success", "bg": "surface", "min": 4.5 },
    { "fg": "success", "bg": "primarySoft", "min": 4.5 },
    { "fg": "danger", "bg": "surface", "min": 4.5 },
    { "fg": "focus", "bg": "background", "min": 3 },
    { "fg": "focusOnDark", "bg": "primary", "min": 3 },
    { "fg": "borderControl", "bg": "surface", "min": 3 }
  ]
}
