diff --git a/src/components/ServiceShowcase.tsx b/src/components/ServiceShowcase.tsx
new file mode 100644
index 0000000..59c0ee2
--- /dev/null
+++ b/src/components/ServiceShowcase.tsx
@@ -0,0 +1,55 @@
+"use client";
+
+import { useState } from "react";
+import ServiceIcon from "@/components/ServiceIcon";
+import { SERVICES } from "@/lib/services";
+
+const featuredServices = SERVICES;
+const initialIndex = Math.max(0, featuredServices.findIndex((service) => service.id === "siska"));
+
+export default function ServiceShowcase() {
+  const [activeIndex, setActiveIndex] = useState(initialIndex);
+  const count = featuredServices.length;
+
+  const move = (direction: -1 | 1) => {
+    setActiveIndex((current) => (current + direction + count) % count);
+  };
+
+  return (
+    <div className="service-stage" aria-label="Layanan digital MySuka">
+      <button className="stage-arrow stage-arrow-left" type="button" onClick={() => move(-1)} aria-label="Layanan sebelumnya">‹</button>
+      <ul className="service-showcase" aria-live="polite">
+        {featuredServices.map((service, index) => {
+          let offset = (index - activeIndex + count) % count;
+          if (offset > count / 2) offset -= count;
+          const visible = Math.abs(offset) <= 2;
+          const position = offset === 0 ? "center" : offset < 0 ? `left-${Math.abs(offset)}` : `right-${offset}`;
+          return (
+            <li
+              className={`showcase-card showcase-${position}${offset === 0 ? " showcase-featured" : ""}${visible ? " is-visible" : " is-hidden"}`}
+              key={service.id}
+              aria-hidden={!visible}
+            >
+              <span className="showcase-number">{String(index + 1).padStart(2, "0")}</span>
+              <span className="showcase-icon"><ServiceIcon id={service.id} size={offset === 0 ? 68 : 58} /></span>
+              <h3>{service.title}</h3>
+              <p>{service.description}</p>
+              <a className="showcase-link" tabIndex={visible ? 0 : -1} href={`/api/sso/launch?app=${service.id}`}>
+                {service.name}<span className="sr-only"> (masuk otomatis)</span>
+              </a>
+            </li>
+          );
+        })}
+      </ul>
+      <button className="stage-arrow stage-arrow-right" type="button" onClick={() => move(1)} aria-label="Layanan berikutnya">›</button>
+      <div className="showcase-controls">
+        <span className="showcase-counter">{String(activeIndex + 1).padStart(2, "0")} / {String(count).padStart(2, "0")}</span>
+        <div className="showcase-dots" aria-label="Pilih layanan">
+          {featuredServices.map((service, index) => (
+            <button key={service.id} type="button" className={index === activeIndex ? "is-active" : ""} onClick={() => setActiveIndex(index)} aria-label={`Tampilkan ${service.name}`} aria-current={index === activeIndex ? "true" : undefined} />
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+}
