+.showcase-controls{position:absolute;left:50%;bottom:1px;z-index:12;display:flex;align-items:center;gap:14px;transform:translateX(-50%)}
+.showcase-counter{font-size:11px;font-weight:800;letter-spacing:.08em;color:#47765b;font-variant-numeric:tabular-nums}
+.showcase-dots{display:flex;align-items:center;gap:6px}
+.showcase-dots button{width:7px;height:7px;padding:0;border:0;border-radius:99px;background:#c9dcd0;cursor:pointer;transition:width .3s,background .3s}
+.showcase-dots button.is-active{width:22px;background:#176d45}
