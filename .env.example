# ---- Domain & routing ----
APP_BASE_URL=http://localhost:3000        # domain publik portal (kontrak: mysuka.portal.ac.id)
SITE_ADDRESS=mysuka.portal.ac.id          # dipakai Caddy (VPS)
ACME_EMAIL=admin@portal.ac.id

# Origin tiap layanan (Caddy merutekan; Next hanya memakainya untuk dev tanpa Caddy, dibaca saat BUILD)
# Pakai skema, tanpa path. Contoh: SISKA_ORIGIN=https://siska-theta.vercel.app (aplikasinya sendiri berbasis path /siska)
SUKAKETEMU_ORIGIN=
CAMPUSFIX_ORIGIN=
SISKA_ORIGIN=
ARCHIVE_ORIGIN=
PAAS_ORIGIN=

# ---- portal-api (FastAPI) ----
ENV=development                           # production di VPS. DIBACA JUGA OLEH Next.js untuk nama cookie: samakan di kedua sisi
SESSION_COOKIE_NAME=                      # kosong = otomatis (production: __Host-mysuka_session, selain itu: mysuka_session); isi hanya bila perlu, nilainya harus sama untuk portal-api dan portal-web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=uin-suka.ac.id
ALLOWED_EMAIL_DOMAINS=student.uin-suka.ac.id,uin-suka.ac.id
STUDENT_EMAIL_DOMAINS=student.uin-suka.ac.id
ADMIN_EMAILS=
# Kunci penandatangan RS256 (PKCS8, baris baru ditulis \n). Wajib di produksi. Hanya portal-api yang memegangnya.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
SSO_PRIVATE_KEY_PEM=
SSO_KEY_ID=mysuka-superapp-key-2026-v1
SSO_ISSUER=                               # kosong = APP_BASE_URL
# Rahasia HMAC untuk id pengguna buram (usr_...). WAJIB di produksi, JANGAN diganti setelah dipakai (semua id berubah).
#   openssl rand -hex 32
IDENTITY_HMAC_SECRET=
# Layanan yang menerima id khusus per layanan + klaim minimal (tanpa email/nama/NIM), dipisah koma
PRIVACY_SERVICES=siska
# Origin tambahan yang boleh melakukan POST logout (dipisah koma). Kosong = hanya APP_BASE_URL (dev: loopback juga boleh)
ALLOWED_ORIGINS=
SESSION_TTL_SECONDS=28800
HANDOFF_TTL_SECONDS=120
# DEV_LOGIN=1                             # login lokal tanpa Google (diabaikan di produksi)

# ---- portal-web (Next.js) ----
SSO_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
API_INTERNAL_URL=http://127.0.0.1:8000
API_ORIGIN=http://127.0.0.1:8000          # dev tanpa Caddy: Next merewrite /api dan JWKS ke sini (dibaca saat build)
