+/* Login page styles are intentionally isolated from the landing-page layout. */
+.login-page{min-height:560px;padding:76px 22px 90px;display:grid;place-items:center;background:radial-gradient(circle at 15% 10%,rgba(25,125,77,.09),transparent 32%),radial-gradient(circle at 90% 80%,rgba(25,125,77,.08),transparent 30%),#f5f8f6}
+.login-card{width:min(100%,510px);padding:48px 46px 42px;border:1px solid #e2ebe5;border-radius:22px;background:#fff;box-shadow:0 18px 55px rgba(15,65,39,.09);text-align:center}
+.login-emblem{width:58px;height:58px;margin:0 auto 20px;display:grid;place-items:center;border-radius:18px;background:#e7f3eb;color:#176d45;font-size:28px}
+.login-eyebrow{font-size:10px;font-weight:800;letter-spacing:.12em;color:#548267}
+.login-card h1{margin-top:12px;font-size:clamp(29px,4vw,36px);line-height:1.2;font-weight:800;letter-spacing:-.8px;color:#193426}
