+.service-stage{position:relative;max-width:790px;height:405px;margin:42px auto 0;display:flex;align-items:center;justify-content:center}
+.service-showcase{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center}
+.showcase-card{position:absolute;display:flex;flex-direction:column;align-items:flex-start;width:190px;min-height:230px;padding:24px 16px 15px;border:1px solid #edf0ed;border-radius:9px;background:#fff;box-shadow:0 3px 8px rgba(17,55,35,.11);color:#155b3a;transition:transform .25s ease,box-shadow .25s ease}
+.showcase-card-1{transform:translate(-280px,14px) scale(.92);z-index:1}
+.showcase-card-2{transform:translate(-140px,-2px) scale(.97);z-index:2}
+.showcase-card-3{transform:translate(0,-2px);z-index:5}
+.showcase-card-4{transform:translate(140px,-2px) scale(.97);z-index:2}
+.showcase-card-5{transform:translate(280px,14px) scale(.92);z-index:1}
+.showcase-card:not(.showcase-featured){top:50%;margin-top:-115px}
+.showcase-number{position:absolute;right:15px;top:12px;font-size:7px;font-weight:800;color:#478767}
+.showcase-icon{height:78px;width:100%;display:flex;align-items:center;justify-content:center;color:#16804f}
+.showcase-icon svg{filter:drop-shadow(0 3px 1px rgba(0,0,0,.08))}
+.showcase-card h3{font-size:11px;line-height:1.35;font-weight:800;color:#155b3a}
+.showcase-card p{margin-top:7px;font-size:8px;line-height:1.4;color:#718078}
+.showcase-link{margin-top:auto;padding-top:9px;width:100%;border-top:1px solid #e4ebe6;color:#26764c;font-size:7px;font-weight:800;text-decoration:none}
+.showcase-link:hover{text-decoration:underline}
+.showcase-featured{width:170px;min-height:232px;padding:24px 17px 14px;background:linear-gradient(145deg,#105a38,#167447);border-color:#176b43;color:#fff;box-shadow:0 8px 18px rgba(8,63,39,.2)}
+.showcase-featured .showcase-icon{height:84px;color:#fff}
+.showcase-featured .showcase-icon svg{width:62px;height:62px}
+.showcase-featured h3{font-size:12px;color:#fff}
+.showcase-featured p{font-size:8px;color:rgba(255,255,255,.78)}
+.showcase-featured .showcase-link{border-color:rgba(255,255,255,.24);color:#d4eddf}
+.showcase-featured::after{content:"";position:absolute;inset:auto 0 0;height:32px;border-radius:0 0 9px 9px;background:var(--pattern) right bottom/75px auto repeat;opacity:.13;pointer-events:none}
+.stage-arrow{position:absolute;top:49%;font-family:Arial,sans-serif;font-size:27px;line-height:1;color:#14643f}
+.stage-arrow-left{left:-8px}.stage-arrow-right{right:-8px}
+
+/* Portal preview and supporting message */
+.connected-section{min-height:410px;padding:20px 6.8% 0;background:var(--paper)}
+.connected-inner{max-width:1160px;margin:0 auto;display:grid;grid-template-columns:1.12fr .88fr;gap:54px;align-items:center}
+.portal-mockup{position:relative;align-self:end;margin-top:4px;padding:10px 10px 13px;border:1px solid #d6d9d7;border-radius:10px 10px 4px 4px;background:linear-gradient(135deg,#f8f8f8,#d7d8d7);box-shadow:0 4px 9px #0002}
+.monitor-camera{position:absolute;top:3px;left:50%;width:4px;height:4px;border-radius:50%;background:#353b38}
+.monitor-screen{min-height:245px;padding:12px 12px 8px;border:1px solid #aeb4b0;background:#fff;box-shadow:inset 0 0 0 3px #f4f5f4}
+.mock-toolbar{display:flex;justify-content:space-between;align-items:center;padding-bottom:9px;border-bottom:1px solid #edf0ed;color:#8a978f;font-size:6px}
+.mock-logo{display:flex;align-items:center;gap:4px;color:#276746;font-weight:800;font-size:8px}
+.mock-logo .mysuka-mark{width:15px;height:15px}.mock-logo .mysuka-mark svg{width:13px;height:13px}
+.mock-heading{padding:9px 0 10px}
+.mock-heading small{display:inline-block;padding:2px 6px;border-radius:10px;background:#e4f2e9;color:#3b805a;font-size:5px;font-weight:800}
+.mock-heading h3{margin-top:4px;font-size:13px;line-height:1.2;color:#172d22}
+.mock-heading p{margin-top:3px;font-size:6px;color:#87938b}
+.mock-services{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
+.mock-service{min-height:112px;padding:8px 6px;border:1px solid #e2e9e4;border-radius:8px;box-shadow:0 2px 4px #173c2510;display:flex;flex-direction:column;align-items:flex-start}
+.mock-icon{width:23px;height:23px;display:grid;place-items:center;border-radius:6px;background:#e8f3ec;color:#26744b}
+.mock-service small{margin-top:7px;font-size:5px;color:#478363;font-weight:800}
+.mock-service strong{margin-top:3px;font-size:7px;line-height:1.3;color:#2b4636}
+.mock-open{margin-top:auto;padding:3px 5px;border-radius:10px;background:#176d45;color:#fff;font-size:5px}
+.mock-pagination{display:flex;justify-content:center;gap:4px;margin-top:8px}
+.mock-pagination i{width:5px;height:3px;border-radius:5px;background:#d5e6db}
+.mock-pagination i:first-child{width:13px;background:#176d45}
+.monitor-neck{width:24%;height:28px;margin:0 auto;background:linear-gradient(90deg,#c8c9c8,#ededed 50%,#b7b9b8)}
+.monitor-foot{width:40%;height:8px;margin:0 auto;border-radius:2px 2px 8px 8px;background:linear-gradient(#b8bab9,#e1e2e1);box-shadow:0 3px 5px #0002}
+.connected-copy{padding:20px 0 35px}
+.connected-brand{background:#fff;color:#2e6949;box-shadow:0 2px 5px #0002}
+.connected-copy h2{margin-top:27px;font-size:clamp(23px,2.4vw,29px);line-height:1.2;font-weight:800;letter-spacing:-.7px}
+.connected-copy>p:not(.hero-brand){max-width:440px;margin-top:14px;color:#718078;font-size:12px;line-height:1.55}
+.checks{margin-top:17px;display:grid;gap:8px}
+.checks li{display:flex;gap:9px;align-items:center;font-size:10px;font-weight:700;color:#344a3c}
+.checks li::before{content:"✓";display:grid;place-items:center;flex:none;width:18px;height:18px;border-radius:50%;background:#e0efe5;color:#26764c;font-size:11px;font-weight:900}
+
+/* Footer */
+.site-footer{position:relative;isolation:isolate;overflow:hidden;color:#dcebe2;background:linear-gradient(115deg,#075332,#09643d 55%,#075332);font-size:10px}
+.site-footer::before{content:"";position:absolute;z-index:-1;inset:0;background:var(--pattern) left bottom/185px auto repeat;opacity:.18}
+.footer-inner{max-width:1160px;margin:0 auto;padding:45px 4.5% 43px;display:grid;grid-template-columns:1.15fr 1fr 1.05fr;gap:70px}
+.footer-brand{display:flex;align-items:center;gap:7px;color:#fff;font-size:14px;font-weight:800}
+.footer-mark{display:grid;place-items:center;width:22px;height:22px}
+.footer-mark svg{width:22px;height:22px}
+.footer-about>p:last-child{max-width:260px;margin-top:12px;color:#c1d9ca;font-size:9px;line-height:1.5}
+.footer-title{margin:2px 0 9px;color:#fff;font-size:9px;font-weight:800}
+.footer-social>p{color:#c1d9ca;font-size:9px;line-height:1.45}
+.social-icons{display:flex;gap:7px;margin-top:12px}
+.social-icons a{width:21px;height:21px;display:grid;place-items:center;border-radius:50%;background:#f4f8f5;color:#17613d;text-decoration:none;font-size:12px;font-weight:900}
+.social-icons a:hover{transform:translateY(-2px)}
+.footer-contact p{display:flex;gap:7px;align-items:flex-start;margin-top:5px;color:#c7ded0;font-size:8px;line-height:1.45}
+.footer-contact p span{width:11px;flex:none;color:#fff;text-align:center}
+.footer-bottom{max-width:1160px;margin:0 auto;padding:15px 20px 17px;border-top:1px solid rgba(255,255,255,.25);text-align:center;color:#c4dacf;font-size:8px}
+
+@media(max-width:760px){
+  .hero{min-height:430px;padding:20px 16px 28px;background-position:center}
+  .hero-frame{min-height:375px}
+  .hero-content{padding:35px 15px}
+  .hero h1{font-size:clamp(27px,7vw,36px);letter-spacing:-.7px}
+  .desktop-break{display:none}
+  .hero-lead{font-size:12px}
+  .services-section{min-height:auto;padding:42px 14px 45px}
+  .section-heading h2{font-size:23px}
+  .service-stage{height:auto;min-height:350px;margin-top:24px;overflow-x:auto;justify-content:flex-start;padding:22px 0 28px;scroll-snap-type:x mandatory}
+  .service-showcase{width:max-content;min-width:100%;height:280px;justify-content:flex-start;gap:12px;padding:0 25px}
+  .showcase-card,.showcase-card-1,.showcase-card-2,.showcase-card-3,.showcase-card-4,.showcase-card-5,.showcase-card:not(.showcase-featured){position:relative;top:auto;left:auto;right:auto;transform:none;margin:0;flex:0 0 180px;min-height:225px;scroll-snap-align:center}
+  .showcase-featured{flex-basis:180px;min-height:245px;order:0}
+  .showcase-card-1{order:-2}.showcase-card-2{order:-1}.showcase-card-4{order:1}.showcase-card-5{order:2}
+  .stage-arrow{display:none}
+  .connected-section{padding:30px 20px 0}
+  .connected-inner{grid-template-columns:1fr;gap:12px}
+  .portal-mockup{order:2;margin-top:5px}
+  .connected-copy{padding:0 0 10px}
+  .connected-copy h2{margin-top:17px;font-size:26px}
+  .connected-copy>p:not(.hero-brand){font-size:12px}
+  .footer-inner{grid-template-columns:1fr 1fr;gap:28px 22px;padding:34px 22px}
+  .footer-contact{grid-column:1/-1}
+}
+@media(max-width:420px){
+  .hero{min-height:400px;padding:14px 12px 20px}
+  .hero-frame{min-height:355px}
+  .hero h1{font-size:27px}
+  .section-heading h2{font-size:21px}
+  .mock-services{gap:4px}
+  .mock-service{padding:6px 4px}
+  .mock-service strong{font-size:6px}
+  .footer-inner{grid-template-columns:1fr;gap:24px}
+  .footer-contact{grid-column:auto}
+}
+@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}}
