+ .hero h1{font-size:clamp(29px,7.2vw,38px)}
+ .hero-lead{font-size:13px}
+ .services-section{min-height:auto;padding:44px 14px 55px}
+ .service-stage{height:370px;max-width:100%;margin-top:24px;overflow:hidden}
+ .showcase-card{width:190px;min-height:250px;padding:22px 15px 14px}
+ .showcase-featured{width:190px;min-height:260px}
+ .showcase-left-1{transform:translate(calc(-50% - 120px),-47%) scale(.82)}
+ .showcase-right-1{transform:translate(calc(-50% + 120px),-47%) scale(.82)}
+ .showcase-left-2,.showcase-right-2{opacity:0!important;pointer-events:none}
+ .stage-arrow{width:36px;height:36px;top:44%;font-size:27px}
+ .stage-arrow-left{left:0}.stage-arrow-right{right:0}
+ .showcase-controls{bottom:0}
+ .connected-section{padding:30px 20px 0}
+ .connected-inner{grid-template-columns:1fr;gap:12px}
+ .portal-mockup{order:2}
+ .connected-copy{padding:0 0 10px}
+ .footer-inner{grid-template-columns:1fr 1fr;gap:28px 22px;padding:34px 22px}
+ .footer-contact{grid-column:1/-1}
+ .login-page{min-height:500px;padding:52px 18px 64px}
+ .login-card{padding:38px 24px 32px}
+ .header-inner{min-height:66px;gap:12px}
+ .nav{gap:0}.nav a{padding:9px 8px;font-size:11px}
+ .brand{font-size:16px}.brand-mark{width:30px;height:30px}
+}
+@media(max-width:420px){
+ .header-inner{width:calc(100% - 24px)}
+ .nav a{font-size:10px;padding-inline:6px}
+ .header-inner>.btn{padding-inline:10px;font-size:11px}
+ .footer-inner{grid-template-columns:1fr;gap:24px}
+ .footer-contact{grid-column:auto}
+}
+.showcase-card{margin-top:0}
+@media(max-width:760px){.service-showcase{position:absolute;inset:0;display:block;min-width:0;width:100%;height:100%;padding:0}.showcase-card{position:absolute;top:50%;left:50%;margin:0}.showcase-card.is-hidden{display:flex}.showcase-left-2,.showcase-right-2{display:none}}
