+.nav{display:flex;gap:8px;margin-left:auto}
+.nav a{padding:10px 13px;border-radius:9px;color:#627369;text-decoration:none;font-size:13px;font-weight:650}
+.nav a:hover,.nav a[aria-current="page"]{background:#eaf4ed;color:#176d45}
+.btn{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 18px;border-radius:10px;text-decoration:none;font-size:13px;font-weight:700}
+.btn-primary{background:#126640;color:#fff}
+.btn-primary:hover{background:#0b5736}
