+.login-description{max-width:370px;margin:14px auto 0;color:#718078;font-size:14px;line-height:1.65}
+.login-submit{min-height:54px;margin-top:30px;padding:0 20px;display:flex;align-items:center;justify-content:center;gap:12px;border-radius:12px;background:#11643f;color:#fff;text-decoration:none;font-size:14px;font-weight:700;box-shadow:0 7px 16px rgba(17,100,63,.2);transition:transform .2s,background .2s,box-shadow .2s}
+.login-submit:hover{transform:translateY(-2px);background:#0b5736;box-shadow:0 10px 22px rgba(17,100,63,.25)}
+.login-submit svg{width:20px;height:20px;flex:none}
+.login-submit span{margin-left:auto;font-size:20px}
+.login-alert{margin-top:20px;padding:12px 14px;border:1px solid #f0d2c8;border-radius:10px;background:#fff5f1;color:#9b3d26;font-size:13px;text-align:left}
+.login-note{margin-top:19px;color:#829087;font-size:11px}
+
+/* Header remains styled on secondary pages such as /login. */
+.container{width:min(100% - 40px,1200px);margin-inline:auto}
+.site-header{position:relative;z-index:20;background:#fff;border-bottom:1px solid #e8eee9}
