+.showcase-left-2{top:50%;left:50%;z-index:2;transform:translate(calc(-50% - 326px),-45%) scale(.9)}
+.showcase-right-1{top:50%;left:50%;z-index:4;transform:translate(calc(-50% + 164px),-48%) scale(.96)}
