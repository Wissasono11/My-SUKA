+
+/* Follow-up refinements: readable scale, accessible login, animated service carousel */
+body{font-size:16px}
+.hero{min-height:560px;padding-top:50px;padding-bottom:62px}
+.hero-frame{min-height:450px}
+.hero-brand{font-size:14px;padding:4px 15px 4px 5px}
+.hero h1{font-size:clamp(36px,4vw,48px);max-width:980px}
+.hero-lead{font-size:15px;max-width:760px}
+.hero-login{font-size:13px;padding:12px 23px 12px 25px}
+.services-section{min-height:900px;padding-top:54px}
+.eyebrow{font-size:13px}
+.section-heading h2{font-size:clamp(27px,2.8vw,34px)}
+.section-heading>p:last-child{font-size:13px}
+.service-stage{max-width:930px;height:450px;margin-top:46px}
+.showcase-card{width:218px;min-height:270px;padding:27px 19px 17px;border-radius:12px;transition:transform .62s cubic-bezier(.22,.75,.25,1),opacity .45s ease,box-shadow .45s ease}
