@@ -44,11 +44,22 @@ def client_ip(request: Request) -> str:
     return xff or request.headers.get("x-real-ip") or (request.client.host if request.client else "unknown")
 
 
-def is_same_origin(request: Request, base_url: str) -> bool:
+_LOOPBACK = {"localhost", "127.0.0.1", "[::1]", "::1"}
+
+
+def is_same_origin(
+    request: Request, base_url: str, extra: tuple[str, ...] | list[str] = (), allow_loopback: bool = False
+) -> bool:
+    """Origin harus sama dengan APP_BASE_URL, atau ada di ALLOWED_ORIGINS.
+    allow_loopback (hanya pengembangan): terima localhost/127.0.0.1 di port mana pun, karena developer sering
+    membuka 127.0.0.1 padahal APP_BASE_URL memakai localhost."""
     origin = request.headers.get("origin")
     if origin:
         u = urlparse(base_url)
-        return origin == f"{u.scheme}://{u.netloc}"
+        if origin == f"{u.scheme}://{u.netloc}" or origin in extra:
+            return True
+        o = urlparse(origin)
+        return allow_loopback and o.scheme == "http" and (o.hostname or "") in _LOOPBACK
     return request.headers.get("sec-fetch-site") == "same-origin"
 
 
diff --git a/portal-api/tests/test_api.py b/portal-api/tests/test_api.py
index 5ab85da..6f1b05f 100644
--- a/portal-api/tests/test_api.py
+++ b/portal-api/tests/test_api.py
@@ -109,3 +109,13 @@ def test_nama_cookie_mengikuti_env_dan_dapat_ditimpa(monkeypatch):
     assert get_settings().session_cookie == "__Host-mysuka_session"
     monkeypatch.setenv("SESSION_COOKIE_NAME", "x_session")
     assert get_settings().session_cookie == "x_session"
+
+
+def test_logout_dev_menerima_loopback_dan_produksi_menolak(client, monkeypatch):
+    lo = {"origin": "http://127.0.0.1:3000"}
+    assert client.post("/api/sso/logout", headers=lo).status_code == 303
+    monkeypatch.setenv("ENV", "production")
+    r = client.post("/api/sso/logout", headers=lo)
+    assert r.status_code == 403 and "APP_BASE_URL" in r.text
+    monkeypatch.setenv("ALLOWED_ORIGINS", "http://127.0.0.1:3000")
+    assert client.post("/api/sso/logout", headers=lo).status_code == 303
