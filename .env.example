# ---- Domain & routing ----
APP_BASE_URL=http://localhost:3000        # domain publik portal (kontrak: mysuka.portal.ac.id)
SITE_ADDRESS=mysuka.portal.ac.id          # dipakai Caddy (VPS)
ACME_EMAIL=admin@portal.ac.id

# Origin tiap layanan (Caddy merutekan; Next hanya memakainya untuk dev tanpa Caddy, dibaca saat BUILD)
# Pakai skema, tanpa path. Contoh: SISKA_ORIGIN=https://siska-theta.vercel.app (aplikasinya sendiri berbasis path /siska)
SUKAKETEMU_ORIGIN=
CAMPUSFIX_ORIGIN=
SISKA_ORIGIN=
ARCHIVE_ORIGIN=
PAAS_ORIGIN=
TERASSC_ORIGIN=

# ---- portal-api (FastAPI) ----
# ENV: AMAN SECARA BAWAAN. Kosong atau salah eja (mis. "prod") = production. Hanya "development" / "test" yang melonggarkan
# (login dev, kunci sementara, cookie tanpa Secure). Di mesin pengembang WAJIB ENV=development. Dibaca juga oleh Next.js.
ENV=development
SESSION_COOKIE_NAME=                      # kosong = otomatis (production: __Host-mysuka_session, selain itu: mysuka_session); isi hanya bila perlu, nilainya harus sama untuk portal-api dan portal-web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_HOSTED_DOMAIN=uin-suka.ac.id
ALLOWED_EMAIL_DOMAINS=student.uin-suka.ac.id,uin-suka.ac.id
STUDENT_EMAIL_DOMAINS=student.uin-suka.ac.id
ADMIN_EMAILS=
# Kunci penandatangan RS256 (PKCS8, baris baru ditulis \n). Wajib di produksi. Hanya portal-api yang memegangnya.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
SSO_PRIVATE_KEY_PEM=
SSO_KEY_ID=mysuka-superapp-key-2026-v1
SSO_ISSUER=                               # kosong = APP_BASE_URL
# Rahasia HMAC untuk id pengguna buram (usr_...). WAJIB di produksi, JANGAN diganti setelah dipakai (semua id berubah).
#   openssl rand -hex 32
IDENTITY_HMAC_SECRET=
# Layanan yang menerima id khusus per layanan + klaim minimal (tanpa email/nama/NIM), dipisah koma
PRIVACY_SERVICES=siska
# Origin tambahan yang boleh melakukan POST logout (dipisah koma). Kosong = hanya APP_BASE_URL (dev: loopback juga boleh)
ALLOWED_ORIGINS=
SESSION_TTL_SECONDS=28800                 # batas MUTLAK sesi (tidak dapat diperpanjang oleh aktivitas)
SESSION_IDLE_SECONDS=1800                 # sesi mati bila tak ada aktivitas selama ini (min. 60)
# Redis untuk sesi, kode otorisasi, dan rate limit (wajib bila >1 worker/replika; di compose diisi otomatis dari REDIS_PASSWORD).
# Kosong = memori satu proses (restart => semua pengguna login ulang).
REDIS_PASSWORD=                           # openssl rand -hex 32 (hex agar aman di dalam URL)
# REDIS_URL=rediss://:<password>@host:6379/0   # hanya bila Redis di luar compose; gunakan rediss:// (TLS) lintas jaringan
HANDOFF_TTL_SECONDS=60                    # umur JWT serah-terima hasil exchange (10-120 dtk)
SSO_CODE_TTL_SECONDS=30                   # umur kode otorisasi sekali pakai (5-60 dtk)
# PKCE: layanan di daftar ini (atau semua bila SSO_REQUIRE_PKCE=1) WAJIB memulai alur sendiri. Launch dari portal tanpa
# code_challenge dialihkan ke /<layanan>/sso-start; exchange tanpa code_verifier ditolak. Aktifkan setelah layanan memasang /sso-start.
# SSO_PKCE_SERVICES=siska
# SSO_REQUIRE_PKCE=1
# Rahasia client per layanan untuk POST /api/sso/exchange (WAJIB, min. 32 karakter acak; tanpa ini launch ke layanan ditolak).
# Berikan nilainya HANYA ke backend layanan terkait lewat secret manager:  openssl rand -base64 48
SSO_CLIENT_SECRET_SUKAKETEMU=
SSO_CLIENT_SECRET_CAMPUSFIX=
SSO_CLIENT_SECRET_SISKA=
SSO_CLIENT_SECRET_ARCHIVE=
SSO_CLIENT_SECRET_PAAS=
SSO_CLIENT_SECRET_TERASSC=
# Rotasi tanpa downtime: isi _NEXT dengan rahasia baru, minta tim layanan memakainya, lalu pindahkan ke nilai utama dan kosongkan _NEXT.
# SSO_CLIENT_SECRET_SUKAKETEMU_NEXT=
# Origin publik terpisah untuk layanan berisiko tinggi (Same-Origin Policy). Kosong = di bawah origin portal.
SISKA_PUBLIC_ORIGIN=                      # mis. https://siska.mysuka.portal.ac.id (harus sama dengan SISKA_PUBLIC_HOST di Caddy)
SISKA_PUBLIC_HOST=                        # dipakai Caddy: host tanpa skema, mis. siska.mysuka.portal.ac.id
# Back-channel logout (opsional, https): portal mengirim logout_token bertanda tangan saat pengguna keluar.
# SUKAKETEMU_BACKCHANNEL_LOGOUT_URL=https://.../sukaketemu/api/backchannel-logout
# Rotasi kunci: simpan JWK PUBLIK kunci lama (array JSON) selama masa tumpang-tindih agar token lama tetap terverifikasi.
# SSO_RETIRED_JWKS=[{"kty":"RSA","kid":"mysuka-superapp-key-2026-v1","n":"...","e":"AQAB"}]
# TRUST_PROXY=1                           # 0 = abaikan X-Forwarded-For (tanpa proxy tepercaya di depan portal-api)
# SSO_LEGACY_TOKEN_HANDOFF=1              # DARURAT/migrasi saja: kirim JWT lewat ?token= (tidak aman; matikan setelah layanan migrasi)
# DEV_LOGIN=1                             # login lokal tanpa Google (diabaikan di produksi)

# ---- portal-web (Next.js) ----
SSO_JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
API_INTERNAL_URL=http://127.0.0.1:8000
API_ORIGIN=http://127.0.0.1:8000          # dev tanpa Caddy: Next merewrite /api dan JWKS ke sini (dibaca saat build)
